    "@hookform/resolvers": "^5.9.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "i18next": "^26.4.2",
    "i18next-browser-languagedetector": "^8.2.1",
    "input-otp": "^1.5.0",
    "lucide-react": "^1.52.0",
    "radix-ui": "^1.7.0",
    "react-hook-form": "^7.89.0",
    "react-i18next": "^17.0.16",
    "sonner": "^2.0.8",
