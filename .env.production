# Fixed build-time flags for the Docker frontend build — never the
# developer's real .env, so a locally-enabled VITE_API_MOCKS=true can never
# ship in a production image. No secrets belong here; Vite only bakes
# VITE_* names into the client bundle, and this is the only file the
# nginx Dockerfile reads for that (see nginx/Dockerfile).
VITE_API_URL=/api
VITE_API_MOCKS=false
