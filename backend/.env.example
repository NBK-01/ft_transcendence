# Application
NODE_ENV=development
PORT=3000
FORCE_HTTPS=false
CORS_ORIGINS=http://localhost:5173

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=your_db_user
DB_PASSWORD=
DB_NAME=shipping_backend_dev
DB_POOL_SIZE=10

# Redis (rate limiting)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_TLS=false

# Rate limiting — tiered limits (global/IP/authenticated), all checked
# together per request; TTLs in milliseconds. Required: app refuses to boot
# if these are missing/invalid AND Redis is unreachable (see
# RateLimitStartupValidatorService).
RATE_LIMIT_GLOBAL_LIMIT=10000000
RATE_LIMIT_GLOBAL_TTL=60000
RATE_LIMIT_IP_LIMIT=1000
RATE_LIMIT_IP_TTL=60000
RATE_LIMIT_AUTH_LIMIT=500
RATE_LIMIT_AUTH_TTL=60000
RATE_LIMIT_CONFIG_CACHE_TTL=30000
RATE_LIMIT_MAX_RECENT_VIOLATIONS=100
RATE_LIMIT_ABUSE_DETECTION_THRESHOLD=5
RATE_LIMIT_SCANNING_DETECTION_THRESHOLD=3
RATE_LIMIT_RECENT_VIOLATIONS_WINDOW=10

# Auth
JWT_SECRET=change_me_dev_only
JWT_ACCESS_TOKEN_EXPIRES_IN=15m
JWT_REFRESH_TOKEN_EXPIRES_IN=30d

# Google OAuth — required at boot (GoogleStrategy's constructor throws if unset)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# File storage — S3-compatible (MinIO locally, same code against real AWS/Railway-MinIO)
AWS_S3_ENDPOINT=http://localhost:9000
AWS_S3_FORCE_PATH_STYLE=true
AWS_REGION=us-east-1
AWS_S3_BUCKET_NAME=avatars
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Swagger (basic auth, non-development only)
SWAGGER_USER=admin
SWAGGER_PASSWORD=change_me

# Email — leave SENDGRID_*/SMTP_* unset in development: emails log to the
# console instead. In production, at least one provider is required (app
# throws at boot otherwise); SendGrid is preferred when both are set.
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=

# SMTP fallback (e.g. Mailtrap) — used when SendGrid isn't configured.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=

FRONTEND_URL=http://localhost:5173

# OTP (account verification) — defaults shown, all optional
OTP_ENABLED=true
OTP_TTL=300
OTP_CODE_LENGTH=6
OTP_MAX_ATTEMPTS=3
OTP_BLOCK_WINDOW=900

# First admin InternalUser — used once by `npm run seed:bootstrap`, idempotent after that.
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=change_me
