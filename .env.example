# Copy to .env and fill in. Never commit .env.

# --- Frontend (Vite reads this file from the repo root) -------------------
# Only VITE_* variables reach the browser. Never put secrets in them.

# API prefix. Leave as /api: Vite proxies it in dev, nginx routes it in prod.
VITE_API_URL=/api
# "true" serves a mock backend in the browser (MSW) — work without the real API.
VITE_API_MOCKS=false

# Dev only: where the Vite proxy sends /api (the NestJS backend).
API_PROXY_TARGET=http://localhost:3000

# --- docker-compose.yml interpolation ($\{DB_USER\}, $\{DB_NAME\}) ----------
# Compose's own ${VAR} substitution in docker-compose.yml only reads this
# root .env (or the shell) — NOT a service's `env_file:`, which only injects
# vars into that container at runtime. Without these here, postgres's
# POSTGRES_USER/POSTGRES_DB and its healthcheck silently resolve empty.
# Keep these in sync with backend/.env's DB_USER/DB_NAME.
DB_USER=
DB_NAME=
